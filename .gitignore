# Build output
build/
build*/
cmake-build*/
obj/

# Binaries and build artifacts
bin/
*.obj
*.o
*.exe
*.dll
*.so
*.dylib
*.lib
*.exp
*.pdb
*.ilk

# Database files produced by tests and examples
*.db
*.bin

# Python
__pycache__/
*.pyc

# External dependencies (absorbed into the project on next milestone;
# kept ignored until they are vendored under third_party/)
external/

# Java binding: the JNA jar is fetched on demand (bindings/java/get_jna.ps1)
bindings/java/lib/
bindings/java/classes/
*.class

# Editor/IDE local settings
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
# Fortran binding artifacts (gfortran module file and the compiled example)
*.mod
bindings/fortran/example

# Visual Studio local state (created by a local dotnet run)
.vs/
*.suo

# Kotlin binding artifacts (compiler output and the JNA jar)
bindings/kotlin/lib/
bindings/kotlin/out/
# Nim binding artifacts (nimcache output and the compiled example)
bindings/nim/.nimcache/
bindings/nim/example_full
bindings/nim/nimcache/

# PHP binding artifacts: the compiled shim (built inside each container, for
# the platform that runs it) and the example's local databases
bindings/php/libsqlite_shim.so
bindings/php/libsqlite_shim.dll
bindings/php/php_demo.db
bindings/php/php_fixture.bin
bindings/php/php_oversize.bin

# FoxPro binding artifacts: the compiled program (.FXP) is generated by the
# VFP runtime from the .prg next to it, and .BAK is the editor's backup copy.
# Both are regenerated on every run, so tracking them would only add churn.
*.FXP
*.BAK