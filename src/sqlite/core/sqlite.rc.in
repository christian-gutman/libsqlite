#include <winres.h>

// Version info (Major, Minor, Patch, Build).
// Values are substituted by CMake from src/sqlite/core/sqlite_core.h,
// which is the single source of truth for the library version.
#define VER_FILEVERSION             @SQLITE_CORE_RC_FILEVERSION@
#define VER_FILEVERSION_STR         "@SQLITE_CORE_RC_FILEVERSION_STR@"
#define VER_PRODUCTVERSION          @SQLITE_CORE_RC_PRODUCTVERSION@
#define VER_PRODUCTVERSION_STR      "@SQLITE_CORE_RC_PRODUCTVERSION_STR@"

#define VER_COMPANYNAME_STR         "@SQLITE_CORE_COMPANY@"
#define VER_FILEDESCRIPTION_STR     "Cross-platform SQLite connector library for C"
#define VER_INTERNALNAME_STR        "libsqlite3"
#define VER_LEGALCOPYRIGHT_STR      "@SQLITE_CORE_COPYRIGHT@"
#define VER_ORIGINALFILENAME_STR    "libsqlite3.dll"
#define VER_PRODUCTNAME_STR         "libsqlite3"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    VER_FILEVERSION
PRODUCTVERSION VER_PRODUCTVERSION
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0" // English (United States), Unicode
        BEGIN
            VALUE "CompanyName",      VER_COMPANYNAME_STR
            VALUE "FileDescription",  VER_FILEDESCRIPTION_STR
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     VER_INTERNALNAME_STR
            VALUE "LegalCopyright",   VER_LEGALCOPYRIGHT_STR
            VALUE "OriginalFilename", VER_ORIGINALFILENAME_STR
            VALUE "ProductName",      VER_PRODUCTNAME_STR
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END